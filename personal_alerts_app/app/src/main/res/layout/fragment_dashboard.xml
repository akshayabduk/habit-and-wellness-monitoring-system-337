<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/title_dashboard"
            style="@style/TextAppearance.PersonalAlerts.Headline"
            android:text="@string/dashboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- BMI Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/TextAppearance.PersonalAlerts.Subtitle"
                    android:text="Latest BMI"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/dashboard_bmi_value"
                    android:text="--"
                    android:textColor="@color/color_secondary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/dashboard_bmi_tag"
                    android:text="Healthy range: 18.5 - 24.9"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/color_on_accent"
                    android:background="@color/color_accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hydration Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/TextAppearance.PersonalAlerts.Subtitle"
                    android:text="Hydration Progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:id="@+id/dashboard_hydration_progress"
                    android:progress="40"
                    android:max="100"
                    android:progressTint="@color/hydration_progress"
                    android:progressBackgroundTint="@color/progress_track"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Exercise Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/TextAppearance.PersonalAlerts.Subtitle"
                    android:text="Exercise Progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:id="@+id/dashboard_exercise_progress"
                    android:progress="20"
                    android:max="100"
                    android:progressTint="@color/exercise_progress"
                    android:progressBackgroundTint="@color/progress_track"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
